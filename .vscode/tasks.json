{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "vs64",
            "action": "build",
            "group": "build",
            "label": "build project"
        },
        {
            "label": "Build Cartridge Image",
            "type": "shell",
            "command": "mkdir -p '${workspaceFolder}/build' && acme -f plain -o '${workspaceFolder}/build/hello_cart.bin' hello_cart.asm && cartconv -t normal -i '${workspaceFolder}/build/hello_cart.bin' -o '${workspaceFolder}/build/hello.crt' -l 0x8000 -n HELLO -p -q",
            "options": {
                "cwd": "${workspaceFolder}/hello"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Build All",
            "dependsOn": [
                "build project",
                "Build Cartridge Image"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
